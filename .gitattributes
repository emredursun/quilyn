# Normalize line endings to LF in the repository for all text files.
* text=auto eol=lf

# Explicit text types
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.svg    text eol=lf
*.txt    text eol=lf
*.xml    text eol=lf

# Binary assets (never normalized)
*.pdf    binary
*.tsu    binary
*.png    binary
*.jpg    binary
*.ico    binary
